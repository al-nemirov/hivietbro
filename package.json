{
  "name": "zalo-bridge-extension",
  "displayName": "HiVietBro — chat translation",
  "version": "0.0.5",
  "description": "Перевод чата Zalo в реальном времени через Claude AI. Вы пишете на родном языке — собеседник получает на вьетнамском (или одном из шести поддерживаемых языков). И наоборот.",
  "author": "Alexander Nemirov",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv2",
    "package": "plasmo package",
    "rebuild": "node scripts/rebuild.mjs"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.13.0",
    "plasmo": "^0.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "manifest": {
    "host_permissions": [
      "https://chat.zalo.me/*",
      "https://*.zalo.me/*",
      "https://accounts.google.com/*",
      "https://oauth2.googleapis.com/*",
      "https://zalo-bridge-api.aleuphoria.workers.dev/*"
    ],
    "permissions": [
      "storage",
      "activeTab",
      "identity"
    ]
  }
}
